; Engine configuration file.
; Lost Abyss - Godot 4.7.2 port of the three.js original.
; 2.5D pixel-styled dark-fantasy prototype: selection stage, town, dungeon.

config_version=5

[application]

config/name="失落的深渊 · The Lost Abyss"
config/version="0.2.0"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/icon.svg"

[autoload]

GameState="*res://scripts/GameState.gd"
AudioBus="*res://scripts/AudioBus.gd"

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

